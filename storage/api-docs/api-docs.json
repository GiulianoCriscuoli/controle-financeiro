        }
    },
    "components": {
        "schemas": {
            "User": {
                "title": "User",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "João da Silva"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "teste@exemplo.com"
                    },
                    "email_verified_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "TypeAccount": {
                "title": "TypeAccount",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Grupo Studio"
                    },
                    "cpf_cnpj": {
                        "type": "string",
                        "example": "12345678000199"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "contato@grupostudio.com"
                    },
                    "phone": {
                        "type": "string",
                        "example": "11987654321"
                    },
                    "type": {
                        "description": "C = cliente, F = fornecedor",
                        "type": "string",
                        "example": "C",
                        "enum": [
                            "C",
                            "F"
                        ]
                    },
                    "user_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "user": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/User"
                            }
                        ],
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "TypeAccountInput": {
                "title": "TypeAccountInput",
                "required": [
                    "name",
                    "cpf_cnpj",
                    "email",
                    "phone",
                    "type"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Grupo Studio",
                        "maxLength": 255,
                        "minLength": 3
                    },
                    "cpf_cnpj": {
                        "description": "Somente dígitos (CPF) ou letras maiúsculas e dígitos (CNPJ), sem pontuação",
                        "type": "string",
                        "example": "12345678000199",
                        "maxLength": 14,
                        "minLength": 11
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "contato@grupostudio.com"
                    },
                    "phone": {
                        "type": "string",
                        "example": "11987654321",
                        "maxLength": 11,
                        "minLength": 10
                    },
                    "type": {
                        "type": "string",
                        "example": "C",
                        "enum": [
                            "C",
                            "F"
                        ]
                    }
                },
                "type": "object"
            },
            "FinancialTransaction": {
                "title": "FinancialTransaction",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "type_account_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "type": {
                        "type": "string",
                        "example": "receber",
                        "enum": [
                            "receber",
                            "pagar"
                        ]
                    },
                    "description": {
                        "type": "string",
                        "example": "Venda de serviço de consultoria mensal"
                    },
                    "amount": {
                        "type": "string",
                        "example": "1500.00"
                    },
                    "issue_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-09-06"
                    },
                    "due_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-10-06"
                    },
                    "status": {
                        "type": "string",
                        "example": "pendente"
                    },
                    "settlement_date": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "type_account": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/TypeAccount"
                            }
                        ],
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "FinancialTransactionInput": {
                "title": "FinancialTransactionInput",
                "required": [
                    "type_account_id",
                    "type",
                    "description",
                    "amount",
                    "issue_date",
                    "due_date",
                    "status"
                ],
                "properties": {
                    "type_account_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "type": {
                        "type": "string",
                        "example": "receber",
                        "enum": [
                            "receber",
                            "pagar"
                        ]
                    },
                    "description": {
                        "type": "string",
                        "example": "Venda de serviço de consultoria mensal",
                        "maxLength": 255,
                        "minLength": 10
                    },
                    "amount": {
                        "type": "number",
                        "format": "float",
                        "example": 1500
                    },
                    "issue_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-09-06"
                    },
                    "due_date": {
                        "description": "Igual ou posterior a issue_date",
                        "type": "string",
                        "format": "date",
                        "example": "2026-10-06"
                    },
                    "status": {
                        "description": "receber: pendente|recebido|vencido|cancelado — pagar: pendente|pago|vencido|cancelado",
                        "type": "string",
                        "example": "pendente"
                    },
                    "settlement_date": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "Sanctum",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Autenticação",
            "description": "Login e logout de usuário"
        },
        {
            "name": "Tipos de Conta",
            "description": "CRUD de clientes e fornecedores"
        },
        {
            "name": "Transações Financeiras",
            "description": "CRUD de contas a pagar e a receber"
        }
    ]
}